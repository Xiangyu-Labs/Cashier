# ==============================================================================
# SYSTEM CONFIGURATION
# 敏感配置 + 启动必需配置
# 这些配置：
#   - 涉及敏感信息（API密钥、密钥）
#   - 应用启动时必需（数据库连接）
#   - 未来不会移到管理页面
#   - 修改后需要重启应用
# ==============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite database connection string.
# Required: No
# Default: file:./data/sqlite.db
DATABASE_URL=file:./data/sqlite.db

# -----------------------------------------------------------------------------
# OpenAI / AI Configuration
# -----------------------------------------------------------------------------
# OpenAI API key used for receipt parsing and categorization.
# Required: Yes
# Default: None
OPENAI_API_KEY=your-api-key-here

# Custom base URL for OpenAI-compatible proxies or gateways.
# Required: No
# Default: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Authentication - Core
# -----------------------------------------------------------------------------
# Secret key for signing cookies and tokens. Generate with: openssl rand -base64 32
# Required: Yes
# Default: None
AUTH_SECRET=

# Server-side base URL for auth callbacks and redirects.
# Required: No
# Default: http://localhost:3000
AUTH_URL=http://localhost:3000

# Resend API key used for OTP and notification emails.
# Required: No
# Default: None
AUTH_RESEND_KEY=

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
# Filesystem path for locally stored uploads.
# Required: No
# Default: ./data/uploads
LOCAL_STORAGE_PATH=./data/uploads

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------
# Trusted proxy chain used for client IP extraction.
# Required: No
# Default: None
TRUSTED_PROXY=

# -----------------------------------------------------------------------------
# System
# -----------------------------------------------------------------------------
# Process timezone for server-side date formatting.
# Required: No
# Default: Asia/Shanghai
TZ=Asia/Shanghai

# ==============================================================================
# RUNTIME CONFIGURATION
# 业务配置 + 功能开关 + 阈值参数
# 这些配置：
#   - 不涉及敏感信息
#   - 可以在运行时调整
#   - 未来会迁移到管理页面（Phase 2+）
#   - 现在通过 .env 配置，修改后需重启
#   - 未来通过管理页面修改，立即生效
# ==============================================================================

# -----------------------------------------------------------------------------
# AI Models & Behavior
# -----------------------------------------------------------------------------
# Default text model used by server-side AI workflows.
# Required: No
# Default: gpt-4o-mini
AI_MODEL_TEXT=gpt-4o-mini

# Default vision model used for image understanding.
# Required: No
# Default: gpt-4o
AI_MODEL_VISION=gpt-4o

# Maximum retry attempts for AI requests.
# Required: No
# Default: 3
AI_MAX_RETRIES=3

# Base retry delay for AI requests in milliseconds.
# Required: No
# Default: 1000
AI_RETRY_DELAY_MS=1000

# Creativity level for structured AI tasks.
# Required: No
# Default: 0.3
AI_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Data Refresh Strategy (TanStack Query staleTime)
# -----------------------------------------------------------------------------
# Client cache stale time for source document queries in milliseconds.
# Required: No
# Default: 120000
SOURCE_DOC_STALE_TIME_MS=120000

# Client cache stale time for currency rate queries in milliseconds.
# Required: No
# Default: 14400000
CURRENCY_STALE_TIME_MS=14400000

# -----------------------------------------------------------------------------
# OTP & Security Settings
# -----------------------------------------------------------------------------
# OTP expiration window in seconds.
# Required: No
# Default: 300
OTP_EXPIRES_SECONDS=300

# Lockout duration after repeated OTP failures in minutes.
# Required: No
# Default: 15
OTP_LOCKOUT_MINUTES=15

# Maximum allowed OTP verification attempts.
# Required: No
# Default: 5
OTP_MAX_ATTEMPTS=5

# Cooldown before the same email can request another OTP in seconds.
# Required: No
# Default: 60
OTP_RESEND_COOLDOWN_SECONDS=60

# Maximum OTP send attempts per rate-limit window.
# Required: No
# Default: 10
AUTH_RATE_LIMIT_MAX=10

# OTP send rate-limit window in seconds.
# Required: No
# Default: 900
AUTH_RATE_LIMIT_WINDOW=900

# Per-minute request limit for API v1 endpoints.
# Required: No
# Default: 60
API_RATE_LIMIT_PER_MINUTE=60

# Per-IP OTP send limit within one hour.
# Required: No
# Default: 10
OTP_IP_MAX_ATTEMPTS_PER_HOUR=10

# Per-IP OTP verification limit within one minute.
# Required: No
# Default: 5
OTP_VERIFY_MAX_ATTEMPTS_PER_MINUTE=5

# Maximum session lifetime in days.
# Required: No
# Default: 14
SESSION_MAX_AGE_DAYS=14

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Set to true to disable new user registrations.
# Required: No
# Default: false
DISABLE_REGISTRATION=false

# -----------------------------------------------------------------------------
# Email Settings
# -----------------------------------------------------------------------------
# Sender mailbox for OTP and login security notifications.
# Supports bare email or `Display Name <email>` format.
# Required: No
# Default: Cashier <noreply@example.com>
AUTH_EMAIL_FROM=Cashier <noreply@example.com>

# -----------------------------------------------------------------------------
# Task Queue
# -----------------------------------------------------------------------------
# Maximum number of concurrent background task workers.
# Required: No
# Default: 10
MAX_TASK_WORKER=10

# Maximum number of ledger entries exported in one request.
# Required: No
# Default: 2000
EXPORT_MAX_ENTRIES=2000

# -----------------------------------------------------------------------------
# Image Processing
# -----------------------------------------------------------------------------
# Maximum input pixels allowed for image processing.
# Required: No
# Default: 25000000
MAX_INPUT_PIXELS=25000000

# Output image quality for local image processing.
# Required: No
# Default: 85
MAX_IMAGE_QUALITY=85

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Pino log level for server logs.
# Required: No
# Default: info
LOG_LEVEL=info

# ==============================================================================
# FRONTEND CONFIGURATION
# 这些配置：
#   - 以 NEXT_PUBLIC_ 前缀暴露给前端
#   - 构建时嵌入 JavaScript 包
#   - 无法运行时修改
#   - 不同环境需要重新构建
# ==============================================================================

# Public application URL embedded in the frontend bundle.
# Required: No
# Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
