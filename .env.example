DATABASE_URL=postgresql://postgres:postgres@db:5432/cashier
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# AI Retry Configuration
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=1000

# Processing Task Configuration
# Number of concurrent workers for processing tasks (default: 1)
PROCESSING_WORKER_COUNT=1

# Logging
LOG_LEVEL=info

# Redis Configuration (Docker Service Name)
REDIS_URL=redis://redis:6379

# BullMQ Worker Configuration
FLOW_MAIN_QUEUE_CONCURRENCY=2      # Concurrent workers for CPU tasks
FLOW_API_QUEUE_CONCURRENCY=2       # Concurrent workers for API tasks
FLOW_API_QUEUE_RATE_MAX=10         # Max API jobs per duration
FLOW_API_QUEUE_RATE_DURATION=60000 # Rate limit duration (ms) - 60s = TPM protection
BULLMQ_LOCK_DURATION=120000        # Job lock timeout (ms) - must > longest task
BULLMQ_STALLED_INTERVAL=30000      # Stalled job check interval (ms)
