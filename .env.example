# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# SQLite database file path (relative to project root)
DATABASE_URL=file:./data/sqlite.db

# ==============================================================================
# OPENAI CONFIGURATION
# ==============================================================================
# Required: Your OpenAI API Key
OPENAI_API_KEY=your-api-key-here

# Optional: Custom Base URL (e.g. for proxies or compatible APIs like Groq/DeepSeek)
OPENAI_BASE_URL=https://api.openai.com/v1

# AI Model Configuration
# Text model: all business logic (parsing, arbitration, categorization) — no vision needed
# Use a cheap text-only model like DeepSeek when AI_MODEL_VISION is configured
AI_MODEL_TEXT=gpt-4o-mini
# Vision model: image description/transcription (needs vision support, called once per document)
# When set, downstream stages use text-only AI_MODEL_TEXT instead of sending images directly
# When not set, AI_MODEL_TEXT must support vision (fallback to current behavior)
AI_MODEL_VISION=gpt-4o

# AI Retry Configuration
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=1000

# ==============================================================================
# AUTHENTICATION (Auth.js)
# ==============================================================================
# Required: Secret key for signing cookies and tokens.
# Generate a secure key with: `openssl rand -base64 32`
AUTH_SECRET=

# Required: Base URL for auth callbacks.
# Local: http://localhost:3000
# Production: https://yourdomain.com
AUTH_URL=http://localhost:3000

# Required for OTP/Email: Resend API Key (https://resend.com)
AUTH_RESEND_KEY=

# Email address for sending OTPs
AUTH_EMAIL_FROM=noreply@example.com

# Rate limiting for login attempts
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=60

# Registration control (set to 'true' to disable new registrations)
DISABLE_REGISTRATION=false

# ==============================================================================
# AUTHENTICATION - OIDC/SSO (Optional)
# ==============================================================================
# Generic OIDC provider configuration for SSO login
# Works with Authelia, Keycloak, Authing, Auth0, or any OIDC-compliant provider
OIDC_ISSUER=https://auth.yourdomain.com
OIDC_CLIENT_ID=cashier-app
OIDC_CLIENT_SECRET=your-client-secret

# Custom name for the SSO button (default: "SSO")
# Examples: "Authelia", "Company SSO", "Enterprise Login"
OIDC_BUTTON_NAME=SSO

# Enable SSO button in login UI
NEXT_PUBLIC_OIDC_ENABLED=false

# Optional: Custom button name for frontend (falls back to OIDC_BUTTON_NAME)
NEXT_PUBLIC_OIDC_BUTTON_NAME=SSO

# ==============================================================================
# APP CONFIGURATION
# ==============================================================================
# Public App URL for frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

APP_DOMAIN=localhost

# Maximum concurrent background tasks (default: 10, set to 0 for unlimited)
MAX_TASK_WORKER=10

# ==============================================================================
# CLOUDFLARE R2 OBJECT STORAGE (Optional - for image storage)
# ==============================================================================
# R2 is used to store uploaded images externally, reducing database size.
# Without R2, images are stored as base64 in the database (causing DB bloat).
#
# Setup Guide:
# 1. Go to https://dash.cloudflare.com → R2
# 2. Create a bucket (e.g., "cashier-images")
# 3. Go to "Manage R2 API Tokens" → Create API Token
# 4. Select "Object Read & Write" permission
# 5. Copy the credentials below
#
# Required: R2 S3-compatible API endpoint
# Format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://xxxxxxxxxxxx.r2.cloudflarestorage.com

# Required: R2 Access Key ID (from API token creation)
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: R2 Secret Access Key (from API token creation)
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: R2 Bucket Name
R2_BUCKET_NAME=cashier-images

# Optional: Custom public domain for serving images
# If set, images will be served from this domain (e.g., https://images.yourdomain.com)
# If not set, images will be served via R2's default public URL (requires public access enabled)
# To enable: R2 Bucket → Settings → Public Access → Allow
R2_PUBLIC_URL=

# Optional: Enable R2 storage (defaults to false for backward compatibility)
# When false, images are stored as base64 in database
# When true, images are uploaded to R2 and only URLs are stored in database
ENABLE_R2_STORAGE=false
