DATABASE_URL=postgresql://postgres:postgres@db:5432/cashier
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# AI Retry Configuration
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=1000

# Processing Task Configuration
# Number of concurrent workers for processing tasks (default: 1)
PROCESSING_WORKER_COUNT=1

# Logging
LOG_LEVEL=info
