DATABASE_URL=postgresql://postgres:postgres@db:5432/cashier
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# AI Retry Configuration
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=1000

# Processing Task Configuration
# Number of concurrent workers for processing tasks (default: 1)
PROCESSING_WORKER_COUNT=1

# Logging
LOG_LEVEL=info

# Redis Configuration (Docker Service Name)
REDIS_URL=redis://redis:6379

# BullMQ Worker Configuration
FLOW_MAIN_QUEUE_CONCURRENCY=2      # Concurrent workers for CPU tasks
FLOW_API_QUEUE_CONCURRENCY=2       # Concurrent workers for API tasks
FLOW_API_QUEUE_RATE_MAX=10         # Max API jobs per duration
FLOW_API_QUEUE_RATE_DURATION=60000 # Rate limit duration (ms) - 60s = TPM protection
BULLMQ_LOCK_DURATION=120000        # Job lock timeout (ms) - must > longest task
BULLMQ_STALLED_INTERVAL=30000      # Stalled job check interval (ms)

# ==========================================
# Authentication (Auth.js)
# ==========================================

# Required: Secret key for signing cookies and tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Required: Base URL for auth callbacks (e.g., https://yourdomain.com)
AUTH_URL=http://localhost:3000

# Public App URL for frontend (e.g., sharing links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for Magic Link: Resend API Key (https://resend.com)
AUTH_RESEND_KEY=

# Email address for sending magic links
AUTH_EMAIL_FROM=noreply@example.com

# Magic link expiration in seconds (default: 900 = 15 minutes)
MAGIC_LINK_EXPIRES_SECONDS=900

# Rate limiting for login attempts
AUTH_RATE_LIMIT_MAX=5              # Max attempts per window
AUTH_RATE_LIMIT_WINDOW=60          # Window duration in seconds

# Registration control (set to 'true' to disable new registrations)
DISABLE_REGISTRATION=false

