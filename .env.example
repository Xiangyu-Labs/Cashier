# Cashier Docker configuration
# Copy this file to .env, fill in Quick Start, then run: docker compose up -d

# =============================================================================
# 1. QUICK START - required for the first deployment
# =============================================================================
INITIAL_USER_EMAIL=
# 8-128 characters, including at least one letter and one number.
INITIAL_USER_PASSWORD=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-4o

# =============================================================================
# 2. COMMON OPTIONS
# =============================================================================
# APP_URL=http://localhost:3000
# APP_PORT=3000
# TZ=Asia/Shanghai
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Cashier <noreply@example.com>
# DISABLE_REGISTRATION=false

# =============================================================================
# 3. EXTERNAL SERVICES - leave unset when using bundled PostgreSQL and MinIO
# =============================================================================
# DATABASE_URL=postgresql://user:password@host:5432/cashier
# S3_ENDPOINT=https://s3.example.com
# S3_PUBLIC_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=cashier
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# =============================================================================
# 4. ADVANCED - application defaults are used when these remain unset
# =============================================================================
# AUTH_SECRET=
# API_KEY_PEPPER=
# TRUSTED_PROXY=
# SESSION_MAX_AGE_DAYS=14
# AI_MAX_RETRIES=3
# AI_RETRY_DELAY_MS=1000
# AI_TEMPERATURE=0.3
# SOURCE_DOC_STALE_TIME_MS=120000
# CURRENCY_STALE_TIME_MS=14400000
# OTP_EXPIRES_SECONDS=300
# OTP_LOCKOUT_MINUTES=15
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW=900
# API_RATE_LIMIT_PER_MINUTE=60
# OTP_IP_MAX_ATTEMPTS_PER_HOUR=10
# OTP_VERIFY_MAX_ATTEMPTS_PER_MINUTE=5
# PROCESSING_RECOVERY_MAX_BATCH=5
# PROCESSING_RECOVERY_MAX_ATTEMPTS=5
# PROCESSING_RECOVERY_COOLDOWN_SECONDS=60
# PROCESSING_TIMEOUT_SECONDS=300
# MAX_INPUT_PIXELS=25000000
# MAX_IMAGE_QUALITY=85
# LOG_LEVEL=info
