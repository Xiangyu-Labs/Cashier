# ==============================================================================
# SYSTEM CONFIGURATION
# 敏感配置 + 启动必需配置
# 这些配置：
#   - 涉及敏感信息（API密钥、密钥）
#   - 应用启动时必需（数据库连接）
#   - 未来不会移到管理页面
#   - 修改后需要重启应用
# ==============================================================================

# -----------------------------------------------------------------------------
# Database (Required)
# -----------------------------------------------------------------------------
DATABASE_URL=file:./data/sqlite.db

# -----------------------------------------------------------------------------
# OpenAI / AI Configuration (Required)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Authentication - Core (Required)
# -----------------------------------------------------------------------------
# Secret key for signing cookies and tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Base URL for auth callbacks. Required for Docker/reverse proxy environments.
# Must match your public-facing URL (e.g., https://cashier.example.com)
AUTH_URL=http://localhost:3000

# Resend API Key for OTP emails (https://resend.com)
AUTH_RESEND_KEY=

# -----------------------------------------------------------------------------
# Authentication - OIDC/SSO (Optional)
# 留空则禁用 SSO 功能
# -----------------------------------------------------------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# File Storage (Optional)
# -----------------------------------------------------------------------------
LOCAL_STORAGE_PATH=./data/uploads

# -----------------------------------------------------------------------------
# Network (Optional)
# -----------------------------------------------------------------------------
TRUSTED_PROXY=

# -----------------------------------------------------------------------------
# System (Optional)
# -----------------------------------------------------------------------------
# Timezone for the application (e.g., Asia/Shanghai, America/New_York)
TZ=Asia/Shanghai

# ==============================================================================
# RUNTIME CONFIGURATION
# 业务配置 + 功能开关 + 阈值参数
# 这些配置：
#   - 不涉及敏感信息
#   - 可以在运行时调整
#   - 未来会迁移到管理页面（Phase 2+）
#   - 现在通过 .env 配置，修改后需重启
#   - 未来通过管理页面修改，立即生效
# ==============================================================================

# -----------------------------------------------------------------------------
# AI Models & Behavior
# -----------------------------------------------------------------------------
AI_MODEL_TEXT=gpt-4o-mini
AI_MODEL_VISION=gpt-4o
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=1000

# AI 输出创造性参数 (0-2范围)，结构化任务建议 0.1-0.3
# 较低值提高 JSON 输出确定性和一致性
AI_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Data Refresh Strategy (TanStack Query staleTime)
# -----------------------------------------------------------------------------

# 源文档数据刷新间隔 (毫秒)
# 默认: 120000 (2分钟)，原值 30秒过于频繁
SOURCE_DOC_STALE_TIME_MS=120000

# 货币汇率数据刷新间隔 (毫秒)
# 默认: 14400000 (4小时)，原值 24小时对于汇率过长
CURRENCY_STALE_TIME_MS=14400000

# -----------------------------------------------------------------------------
# OTP & Security Settings
# -----------------------------------------------------------------------------
OTP_EXPIRES_SECONDS=300
OTP_LOCKOUT_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate limiting for OTP send attempts (per email per window)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=900

# API v1 限流 (每分钟请求数)
# 默认: 60，原值 20/分钟对于集成场景过于严格
API_RATE_LIMIT_PER_MINUTE=60

# IP 级别 OTP 发送限流 (每小时每IP最大次数)
# 默认: 10
OTP_IP_MAX_ATTEMPTS_PER_HOUR=10

# OTP 验证限流 (每分钟每IP最大次数)
# 默认: 5，原值 10 过于宽松
OTP_VERIFY_MAX_ATTEMPTS_PER_MINUTE=5

# 用户会话有效期 (天)
# 默认: 14，原值 30天对于财务应用过长
# 增加会话劫持风险，建议 7-14 天
SESSION_MAX_AGE_DAYS=14

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
DISABLE_REGISTRATION=false

# -----------------------------------------------------------------------------
# Email Settings
# -----------------------------------------------------------------------------
AUTH_EMAIL_FROM=noreply@example.com

# -----------------------------------------------------------------------------
# Task Queue
# -----------------------------------------------------------------------------
MAX_TASK_WORKER=10

# 账本条目单次导出最大数量
# 默认: 2000，原值 10000 可能导致内存问题
# 超出此限制的数据应使用日期范围筛选或异步导出
EXPORT_MAX_ENTRIES=2000

# -----------------------------------------------------------------------------
# Image Processing
# -----------------------------------------------------------------------------

# 图片处理最大输入像素 (防止 OOM)
# 默认: 25000000 (2500万像素, ~5000x5000)
# 原值 100000000 (1亿像素) 可能导致内存问题
MAX_INPUT_PIXELS=25000000

# 图片处理质量 (1-100)
# 默认: 85，JPEG/WebP 压缩质量
MAX_IMAGE_QUALITY=85

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# ==============================================================================
# FRONTEND CONFIGURATION
# 这些配置：
#   - 以 NEXT_PUBLIC_ 前缀暴露给前端
#   - 构建时嵌入 JavaScript 包
#   - 无法运行时修改
#   - 不同环境需要重新构建
# ==============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# OIDC Frontend Settings
NEXT_PUBLIC_OIDC_ENABLED=false
NEXT_PUBLIC_OIDC_BUTTON_NAME=SSO
