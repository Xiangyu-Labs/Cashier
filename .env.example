# External-service deployment: copy to .env and provide every required value.

# Application
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=
APP_URL=http://localhost:3000
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-4o

# External PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/cashier
# DATABASE_POOL_MAX=2

# External S3 / Cloudflare R2 (bucket must already exist)
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=cashier
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional authentication
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Cashier <noreply@example.com>
# DISABLE_REGISTRATION=false
# DEV_AUTH_BYPASS=false

# Internal secrets. The Docker entrypoint generates stable values in cashier_config when blank.
# AUTH_SECRET=
# API_KEY_PEPPER=
# RATE_LIMIT_PEPPER=
# AUTH_OTP_PEPPER=

# Advanced
# APP_PORT=3000
# TZ=Asia/Shanghai
# Set only when every request reaches the app through a trusted reverse proxy that overwrites
# X-Real-IP/X-Forwarded-For. Leave unset for direct deployments; unknown IPs skip IP-only OTP limits.
TRUSTED_PROXY=platform
# SESSION_MAX_AGE_DAYS=14
# AUTH_PASSWORD_EMAIL_MAX_ATTEMPTS=10
# AUTH_PASSWORD_IP_MAX_ATTEMPTS=50
# AUTH_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
# LEDGER_STARTUP_CACHE_DOCUMENT_LIMIT=300
# AI_MAX_RETRIES=3
# AI_RETRY_DELAY_MS=1000
# AI_REQUEST_TIMEOUT_MS=60000
# AI_REVISION_DEADLINE_MS=180000
# UPLOAD_PLAN_LIMIT_PER_15_MIN=20
# UPLOAD_OPEN_SESSION_LIMIT=5
# UPLOAD_DAILY_BYTES_LIMIT=104857600
# AI_TEMPERATURE=0.3
# SOURCE_DOC_STALE_TIME_MS=120000
# CURRENCY_STALE_TIME_MS=14400000
# PROCESSING_RECOVERY_MAX_BATCH=5
# PROCESSING_RECOVERY_MAX_ATTEMPTS=5
# PROCESSING_RECOVERY_COOLDOWN_SECONDS=60
# MAX_INPUT_PIXELS=25000000
# MAX_IMAGE_QUALITY=85
# LOG_LEVEL=info

# Storage prune (npm run prune) uses DATABASE_URL plus the S3/R2 variables above.
# It is dry-run by default; pass --apply to delete. See docs/deployment.md.
