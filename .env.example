# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Connect to PostgreSQL. 
# In Docker, these are used to construct the DATABASE_URL.
# Ideally, keep the database isolated and only expose what's necessary.

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cashier

# Constructed URL for local development (optional, Docker constructs this automatically)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashier

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# Connect to Redis.
# Used for queuing (BullMQ) and caching.

REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# Constructed URL for local development (optional, Docker constructs this automatically)
# REDIS_URL=redis://localhost:6379

# ==============================================================================
# OPENAI CONFIGURATION
# ==============================================================================
# Configuration for AI features.

# Required: Your OpenAI API Key
OPENAI_API_KEY=your-api-key-here

# Optional: Custom Base URL (e.g. for proxies or compatible APIs like Groq/DeepSeek)
OPENAI_BASE_URL=https://api.openai.com/v1

# The model to use for processing
OPENAI_MODEL=gpt-4o

# AI Retry Configuration
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=1000

# ==============================================================================
# AUTHENTICATION (Auth.js)
# ==============================================================================
# Secure your application.

# Required: Secret key for signing cookies and tokens.
# Generate a secure key with: `openssl rand -base64 32`
AUTH_SECRET=

# Required: Base URL for auth callbacks.
# Local: http://localhost:3000
# Production: https://yourdomain.com
AUTH_URL=http://localhost:3000

# Required for OTP/Email: Resend API Key (https://resend.com)
AUTH_RESEND_KEY=

# Email address for sending OTPs
AUTH_EMAIL_FROM=noreply@example.com

# Rate limiting for login attempts
AUTH_RATE_LIMIT_MAX=5              # Max attempts per window
AUTH_RATE_LIMIT_WINDOW=60          # Window duration in seconds

# Registration control (set to 'true' to disable new registrations)
DISABLE_REGISTRATION=false

# ==============================================================================
# APP CONFIGURATION
# ==============================================================================

# Public App URL for frontend (e.g., used for sharing links, SEO)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# ==============================================================================
# BACKGROUND WORKERS (BullMQ)
# ==============================================================================
# Configuration for the job validation and processing system.

# Number of concurrent workers for processing tasks (default: 1)
# High CPU usage tasks should keep this low based on core count.
PROCESSING_WORKER_COUNT=1

# Concurrent workers for main flow queue
FLOW_MAIN_QUEUE_CONCURRENCY=2

# Concurrent workers for API queue
FLOW_API_QUEUE_CONCURRENCY=2

# Max API jobs per duration (Rate Limiting)
FLOW_API_QUEUE_RATE_MAX=10

# Rate limit duration (ms) - 60s = TPM protection
FLOW_API_QUEUE_RATE_DURATION=60000

# Job lock timeout (ms) - must be greater than largest expected task duration
BULLMQ_LOCK_DURATION=120000

# Stalled job check interval (ms)
BULLMQ_STALLED_INTERVAL=30000

# ==============================================================================
# PUSH NOTIFICATIONS (Web Push)
# ==============================================================================
# Generate keys using: `npx web-push generate-vapid-keys`

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

