# Bundled local-stack deployment: copy to .env.
# PostgreSQL and MinIO use fixed local-only credentials from docker-compose.local.yml.

INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=
APP_URL=http://localhost:3000
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-4o

# Docker generates and persists these values when they are left blank.
# AUTH_SECRET=
# API_KEY_PEPPER=
# RATE_LIMIT_PEPPER=
# AUTH_OTP_PEPPER=

# Optional
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Cashier <noreply@example.com>
# AUTH_PASSWORD_EMAIL_MAX_ATTEMPTS=10
# AUTH_PASSWORD_IP_MAX_ATTEMPTS=50
# AUTH_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
# DISABLE_REGISTRATION=false
# DEV_AUTH_BYPASS=false
# APP_PORT=3000
# S3_PORT=9000
# TZ=Asia/Shanghai
# LOG_LEVEL=info

# See docs/configuration.md for all supported variables and defaults.
