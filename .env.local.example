# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Connect to the Dockerized DB from the host machine (npm run dev).
# Ensure 'docker-compose up db' is running and port 5432 is mapped.
# Must match credentials in .env (POSTGRES_USER/PASSWORD).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashier

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# Connect to Dockerized Redis from the host machine.
# Ensure 'docker-compose up redis' is running and port 6379 is mapped.
REDIS_URL=redis://localhost:6379

# ==============================================================================
# OPENAI CONFIGURATION
# ==============================================================================
# OpenAI Compatible API Configuration

OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.0-flash-exp

# AI Retry Configuration (Optional overrides)
# AI_MAX_RETRIES=3
# AI_RETRY_DELAY_MS=1000

# ==============================================================================
# AUTHENTICATION (Auth.js)
# ==============================================================================

# Required: Secret key for signing cookies and tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Required: Base URL for auth callbacks (e.g., https://yourdomain.com)
AUTH_URL=http://localhost:3000

# Required for OTP/Email: Resend API Key (https://resend.com)
AUTH_RESEND_KEY=

# Email address for sending OTPs
AUTH_EMAIL_FROM=noreply@example.com

# Rate limiting for login attempts
AUTH_RATE_LIMIT_MAX=5              # Max attempts per window
AUTH_RATE_LIMIT_WINDOW=60          # Window duration in seconds

# Registration control (set to 'true' to disable new registrations)
DISABLE_REGISTRATION=false

# ==============================================================================
# APP CONFIGURATION
# ==============================================================================

# Public App URL for frontend (e.g., sharing links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application Logging Level (debug, info, warn, error)
LOG_LEVEL=debug

# ==============================================================================
# BACKGROUND WORKERS (BullMQ)
# ==============================================================================

# Processing Task Configuration
PROCESSING_WORKER_COUNT=1

# BullMQ Worker Configuration (can be lower for local dev)
FLOW_MAIN_QUEUE_CONCURRENCY=1
FLOW_API_QUEUE_CONCURRENCY=1
FLOW_API_QUEUE_RATE_MAX=5
FLOW_API_QUEUE_RATE_DURATION=60000
BULLMQ_LOCK_DURATION=120000        # Job lock timeout (ms) - must > longest task
BULLMQ_STALLED_INTERVAL=30000      # Stalled job check interval (ms)

# ==============================================================================
# PUSH NOTIFICATIONS (Web Push)
# ==============================================================================

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
