# Bundled local-stack deployment: copy to .env.
# PostgreSQL and MinIO use fixed local-only credentials from docker-compose.local.yml.

INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=
APP_URL=http://localhost:3000
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-4o

# Optional
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Cashier <noreply@example.com>
# DISABLE_REGISTRATION=false
# DEV_AUTH_BYPASS=false
# APP_PORT=3000
# S3_PORT=9000
# TZ=Asia/Shanghai
# LOG_LEVEL=info
