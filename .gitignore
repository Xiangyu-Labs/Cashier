.tmp/
.DS_Store
*.pem
/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

