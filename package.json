{
  "name": "cashier",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "tsc": "tsc --noEmit",
    "validate:i18n": "node scripts/validate-i18n-catalogs.mjs",
    "check": "npm run test:prepare && eslint && tsc --noEmit && vitest run --config vitest.unit.config.ts && vitest run --config vitest.integration.config.ts --reporter=dot && node scripts/run-test-coverage.mjs && next build --webpack && node scripts/validate-i18n-catalogs.mjs",
    "test:prepare": "node scripts/prepare-test-postgres.mjs",
    "test": "npm run test:prepare && vitest --config vitest.config.ts",
    "test:run": "npm run test:prepare && vitest run --config vitest.config.ts",
    "test:unit": "npm run test:prepare && vitest run --config vitest.unit.config.ts",
    "test:integration": "npm run test:prepare && vitest run --config vitest.integration.config.ts --reporter=dot",
    "test:coverage": "node scripts/run-test-coverage.mjs",
    "docker:build": "docker compose build",
    "docker:prod": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-database.mjs",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "performance:analyze": "node scripts/performance/analyze-client-bundle.mjs --build",
    "performance:report": "node scripts/performance/write-performance-report.mjs",
    "performance:baseline": "node scripts/performance/run-performance-baseline.mjs"
  },
